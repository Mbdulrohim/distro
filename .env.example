# Copy to web/.env.local for local development. Never commit a filled-in env file.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. See docs/CTO_REVIEW.md security section.
SUPABASE_SERVICE_ROLE_KEY=

# --- Monad (Mainnet only) ---
# Optional: a private/rate-limited RPC endpoint. Falls back to viem's public
# Monad RPC when unset. Chain id 143.
NEXT_PUBLIC_MONAD_MAINNET_RPC_URL=

# --- Auth / session ---
# Secret used to sign SIWE session JWTs. Generate a strong value, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Server-only — must NOT have a NEXT_PUBLIC_ prefix.
SESSION_SECRET=

# --- Wallet connect (optional, for future WalletConnect connector) ---
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# --- Staging (testnet) ---
# Off by default. When unset, the app is Monad Mainnet ONLY — auth refuses any
# other chain and wagmi knows no other network. Set to "true" ONLY for a
# staging build, to exercise execution against the testnet deployment before
# the contract is audited. Never set this in production.
NEXT_PUBLIC_ENABLE_TESTNET=
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=

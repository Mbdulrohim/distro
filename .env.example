# Copy to web/.env.local for local development. Never commit a filled-in env file.

# --- Supabase ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Never expose to the client. See docs/CTO_REVIEW.md security section.
SUPABASE_SERVICE_ROLE_KEY=

# --- Monad RPC ---
NEXT_PUBLIC_MONAD_TESTNET_RPC_URL=
NEXT_PUBLIC_MONAD_MAINNET_RPC_URL=
NEXT_PUBLIC_MONAD_CHAIN=testnet
# Chain IDs (reference): testnet = 10143, mainnet = 143

# --- WalletConnect / wallet integration ---
# Required once wallet-integration (Para) is wired up per the monskills skill.
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=
